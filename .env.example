# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The canonical base URL where Lumiq TV is hosted.
# Used for canonical URLs, XML sitemaps, OpenGraph metadata, and robots.txt.
APP_URL="https://lumiqtv.example.com"

# PAYMENT_PROVIDER_MODE: Configurable payment provider adapter ("manual_review" | "stripe_webhook" | "invoice").
# Defaults to "manual_review" until live gateway credentials and webhooks are configured.
PAYMENT_PROVIDER_MODE="manual_review"
PAYMENT_WEBHOOK_SECRET=""

# EMAIL_PROVIDER_MODE: Configurable transactional email provider ("preview_queue" | "resend" | "smtp").
# Defaults to "preview_queue" until live email credentials are configured and verified.
EMAIL_PROVIDER_MODE="preview_queue"
EMAIL_FROM_ADDRESS="support@lumiqtv.example.com"
